OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Docker Compose api/worker containers cannot reach host services through
# 127.0.0.1. For local Ollama, use:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
CHAT_MODEL=stepfun/step-3.5-flash:free
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

TOP_K=3
RETRIEVAL_SEARCH_TYPE=similarity
RETRIEVAL_FETCH_K=8
RERANKER_ENABLED=false
RERANKER_STRATEGY=embedding_lexical
RETRIEVAL_MAX_CONTEXT_CHARS=4000
CHUNK_SIZE=800
CHUNK_OVERLAP=120
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FILE_NAME=app.log
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_SQLITE_PATH=./storage/checkpoints.sqlite3
FEEDBACK_LOG_PATH=./storage/feedback.jsonl

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# For shared infrastructure, replace the four URLs above and start with:
# docker compose -f docker-compose.yml -f docker-compose.external.yml up -d --build api worker
EXTERNAL_DOCKER_NETWORK=dayboard_default
RAG_HOST_PORT=8001
RAG_BASE_PATH=/rag/
RAG_API_BASE_URL=/rag-api
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
HOT_QUESTION_CACHE_ENABLED=true
HOT_QUESTION_CACHE_TTL_SECONDS=300
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-rag
LANGSMITH_ENDPOINT=
TOKEN_INPUT_COST_PER_1K=0
TOKEN_OUTPUT_COST_PER_1K=0

# Docker Compose api/worker services override database and Redis URLs to use
# internal service names: postgres and redis. If you use bge-m3, set
# EMBEDDING_DIMENSION=1024 before running migrations.
